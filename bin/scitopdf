#!/usr/bin/env -S bash
#set -ex

# NB: I patch up this script on the fly.
#     There are a few redundancies, some
#     incoherent formatting and oopsies.
#     It could really benefit from clean
#     up and contributions! Feel free :)
#                   -- dougy147

USER_AGENT="Mozilla/5.0 (x11; ubuntu; linux x86_64; rv:59.0) gecko/20100101 firefox/59.0"
COOKIE_JAR="$(mktemp)"
trap 'rm -f "$COOKIE_JAR"' EXIT

# Fetch a page. If Sci-Hub answers with its "are you a robot?" page,
# solve the ALTCHA proof-of-work (like the browser does) and fetch again.
fetch_page() {
    local response page effective_url base challenge_id challenge payload
    response=$(curl -Ls --connect-timeout 10 -c "$COOKIE_JAR" -b "$COOKIE_JAR" -w '\n%{url_effective}' "$1")
    effective_url="${response##*$'\n'}"
    page="${response%$'\n'*}"
    challenge_id=$(grep -oP '/captcha/challenge/\K[0-9]+' <<< "$page" | head -n 1)
    if [[ -n "$challenge_id" ]]; then
        base=$(grep -oE '^https?://[^/]+' <<< "$effective_url")
        challenge=$(curl -s --connect-timeout 10 -c "$COOKIE_JAR" -b "$COOKIE_JAR" "${base}/captcha/challenge/${challenge_id}")
        payload=$(perl -MDigest::SHA=sha256_hex -MMIME::Base64 -e '
            my $json = shift;
            my %c = map { $_ => ($json =~ /"$_":"?([^",}]*)/)[0] } qw(algorithm challenge maxNumber salt signature);
            for my $n (0 .. $c{maxNumber}) {
                next unless sha256_hex($c{salt} . $n) eq $c{challenge};
                print encode_base64(sprintf(q({"algorithm":"%s","challenge":"%s","number":%d,"salt":"%s","signature":"%s","took":1}),
                    @c{qw(algorithm challenge)}, $n, @c{qw(salt signature)}), "");
                exit 0;
            }
            exit 1;' "$challenge") || { printf '%s\n' "$page"; return; }
        curl -s --connect-timeout 10 -c "$COOKIE_JAR" -b "$COOKIE_JAR" -o /dev/null \
             -H 'Content-Type: application/json' -d "{\"captcha\":\"${payload}\"}" \
             "${base}/captcha/solution/${challenge_id}"
        page=$(curl -Ls --connect-timeout 10 -c "$COOKIE_JAR" -b "$COOKIE_JAR" "$effective_url")
    fi
    printf '%s\n' "$page"
}

# Read HTML on stdin, print the first link to a .pdf file
extract_pdf_link() {
    grep -ioP "(?<=(src|content|data\ )=\")[^'\"]+?\.pdf" | head -n 1
}

display_logo() {
    if [[ ! $quiet = true ]]; then
        echo "${_G}  ▄▀▀░▄▀▀░█░▀█▀░▄▀▄▒█▀▄░█▀▄▒█▀ "
        echo      "  ▄██░▀▄▄░█░▒█▒░▀▄▀░█▀▒▒█▄▀░█▀ ${_RST}"
    fi
}

display_help() {
    echo -e "Help menu : \
        \n -l : Download references line by line from a bibliography file \
        \n -D : Store papers in a specified directory \
        \n -u : Set Sci-Hub URL \
        \n -p : Turn auto-opening off \
        \n -q : Quiet mode, no echo except for errors \
        \n -h : Print this help menu \
        \n man scitopdf : Check the manual for more tweaks \
        \n \
        \n Example : $0 \"protein measurement with the folin\" -p -q -D \"$HOME/science\""
}

# Preparing formatted outputs
_R=$'\e[;31m' _G=$'\e[;32m'  _Y=$'\e[;33m' _B=$'\e[;34m' _BLACK=$'\e[;30m'
_RST=$'\e[0m' _BOLD=$'\e[1m' _DIM=$'\e[2m' _ITAL=$'\e[3m' _UNDL=$'\e[4m' _BLNK=$'\e[5m'
_ERASE=$'\r\033[0K'    #Cursor to EOL (\r resets cursor to left)
_ERASE_UP=$'\r\033[1A' #Erase one line up

parse_args() {
    local ARGS=("$@")
    for (( i=0;i<${#ARGS[@]};i++)); do
        case "${ARGS[i]}" in
            -l|--list)
                ((i++))
                bibliography_file="${ARGS[i]}"
                listing=true
                ;;
            -D|--download-dir)
                ((i++))
                destination=$(realpath "${ARGS[i]}")
                ;;
            -u|--url)
                ((i++))
                user_url="${ARGS[i]}"
                ;;
            -p|--no-auto-open)
                automatically_open=false
                ;;
            -q|--quiet)
                quiet=true
                ;;
            -w|--wait)
                ((i++))
                wait_between_requests="${ARGS[i]}"
                if [[ ! $wait_between_requests =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                    echo "${_R}[ERROR] \"--wait\" only accepts integers or decimals (e.g. 1.5).${_RST}"
                    exit 1
                fi
                ;;
            -b|--break-after)
                ((i++))
                break_after="${ARGS[i]}"
                if [[ ! $break_after =~ ^[0-9]+?$ ]]; then
                    echo "${_R}[ERROR] \"--break-after\" only accepts integers.${_RST}"
                    exit 1
                fi
                if [ $break_after = 0 ]; then
                    unset break_after
                fi
                # set a default break duration in case not set
                if [ -z $break_for ]; then
                    break_for=15
                fi
                ;;
            -d|--break-for)
                ((i++))
                break_for="${ARGS[i]}"
                if [[ ! $break_for =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                    echo "${_R}[ERROR] \"--break-for\" only accepts integers or decimals (e.g. 1.5).${_RST}"
                    exit 1
                fi
                ;;
            --dmenu)
                menu="dmenu"
                ;;
            --ref)
                bib_ref="true"
                ;;
            -h|--help)
                display_help
                exit 0
                ;;
            *)
                concatenate+=" ${ARGS[i]}"
                if [ -z "$automatically_open" ]; then
                    automatically_open=true
                fi
                ;;
        esac
    done
    concatenate="${concatenate/ /}"
}

# Set/check download folder #
set_download_folder() {
    # Check system default download folder
    XDG_DOWNLOAD_DIR="${XDG_DOWNLOAD_DIR:-$(xdg-user-dir DOWNLOAD 2>/dev/null)}"
    XDG_DOWNLOAD_DIR="${XDG_DOWNLOAD_DIR:-$HOME/Downloads/scitopdf}"

    destination="${destination:-$XDG_DOWNLOAD_DIR/scitopdf}"

    # Check download folder permissions
    if ! mkdir -p "$destination" >/dev/null; then
        destination="$(mktemp)"
        echo -e "${_B}[info] Can't access \"${destination}\". Ensure you have permissions.\nPapers will be saved to ${TMP}.${_RST}"
    fi
}

# Set/check PDF reader #
set_pdf_reader() {
    # Find default PDF reader, else use zathura or give instructions
    [ -n "$READER" ] && return
    # If xdg-open available, use it to call PDF reader.
    [[ $(command -v xdg-open) ]] && READER=xdg-open && return
    # If xdg-mime fails or doesn't exist, use or propose zathura
    [[ $(command -v zathura) ]] && READER=zathura && return
    echo -e "${_B}[info] Default PDF reader not found.\nInstall \"zathura\" or try setting a READER environment variable.\nExample : 'export READER=your_pdf_reader'"
}

set_url() {
    # If user provided URL, check it
    if [ -n "${user_url+x}" ]; then
        for prefix in "" http https; do
            curl -s "${prefix}$user_url" > /dev/null
            [[ $? != 0 ]] && continue
            site="${prefix}$user_url"
            url_is_fine=true
            return
        done

        echo "${_R}Provided URL is unreachable${_RST}"
        exit 1
    fi

    # Use "known working" Sci-Hub URLs if no URL provided
    # (adapt according to location/lang/..., send PR!)
    # might need shopt -s extglob for pattern matching
    case "$LANG" in
        en_*) site="https://www.sci-hub.st";; # can somebody test?
        fr_*) site="https://www.sci-hub.st";; # can somebody test?
        ru_*) site="https://www.sci-hub.ru";; # can somebody test?
        *)    site="https://www.sci-hub.st";;
    esac

    curl -s "$site" > /dev/null
    [[ $? == 0 ]] && return

    echo "${_Y}$site unreachable. Trying an alternative URL:${_RST}"

    local regex="\"https://(www.)?sci[^\"]+\""
    while read url; do
        #echo -e "\t- ${url//\"/}"
        curl -s "${url//\"/}" > /dev/null
        [[ $? != 0 ]] && continue
        site="${url//\"/}"
        return
    done < <(curl -s -LH "" "https://www.sci-hub.pub/" | grep -Eo "$regex")
    echo "${_R}Could not connect to Sci-Hub${_RST}"
    exit 1
}

# User search on Crossref #
search_crossref() {
    # New mindful and kind way to ask Crossref (API) [consider first paper as match]
    # Filter journal-article only. Is that ok for you?
    doi=$(curl -A "$USER_AGENT" -s "https://api.crossref.org/works?query=${user_search}&filter=type:journal-article" | \
          grep -Eo "\"DOI\"\s*:\s*\"[^\"]*" | \
          head -n 1                         | \
          sed -E "s/\"DOI\"\s*:\s*\"//"     | \
          sed 's_\\__')

    download_link="$(fetch_page "${site}/$doi" | extract_pdf_link)"
    check_website_url_inside_link
}

# *New* search paper on libgen.li as last resort
search_libgen() {
    libgen="https://libgen.li"
    libgen_no_prot="libgen.li"

    result=$(curl -s "${libgen}/index.php?req=$doi" | grep -Eo "edition.php\?id=[^\"]*" | head -n1)
    if [ -z $result ]; then
        return 1
    fi
    link_step_1=$(curl -s "${libgen}/$result" | grep -Eo "ads.php\?md5=[^\"]*")
    if [ -z $link_step_1 ]; then
        return 1
    fi

    full_last_page=$(curl -s "${libgen}/$link_step_1")
    link_step_2=$(grep -Eo "get.php\?md5=[^\"]*" <<< "$full_last_page") # link

    # need to check again how to extract correct metadatas
    lg_author=$(grep -Eo "Author\(s\)\s*:\s*[^, ]*" <<< "$full_last_page" | \
                sed -E "s/Author\(s\)\s*:\s*//"                           | \
                tr 'A-Z' 'a-z') # author

    lg_year=$(grep -Eo "Year\s*:\s*[[:digit:]]*" <<< "$full_last_page" | \
              sed -E "s/Year\s*:\s*//") # year

    if [ -z $link_step_2 ]; then
        return 1
    fi
    download_link="${libgen}/$link_step_2"
}

# Look for paper #
paper_search() {
    url_without_http=$(sed 's/https\?:\/\///' <<< "$site")

    if [[ -z ${automatically_open+x} ]]; then
        automatically_open=true
    fi

    if [[ -z "$concatenate" ]]; then
        if [[ $menu == "dmenu" ]]; then
            concatenate=$(printf "" | dmenu -i -p "Paper")
        else
            if [[ ! $quiet = true ]]; then
                echo "${_BOLD}Search paper ${_RST}[title, author, year, DOI, journal, URL...] : "
            fi
            read -r concatenate
        fi
        [[ ${concatenate} == "" ]] || paper_search
    else
        init_user_search="$concatenate"
        user_search=$(sed "s/'/\ /;s/\ /+/g" <<< "$concatenate" | sed 's/\\//g;s/^+//;s/+$//' | iconv -f utf8 -t ascii//TRANSLIT)

        # 	>> IF USER_SEARCH IS A VALID URL
        if [[ $concatenate =~ https?:// && ! $concatenate =~ doi ]]; then
            concatenate=$(sed "s/'//g ; s/\ //g" <<< "$concatenate" | sed 's/\\//g')
            download_link="$(fetch_page "$concatenate" | extract_pdf_link)"
            if [[ -z "${download_link}" ]]; then
                download_link="$(fetch_page "${site}/${concatenate}" | extract_pdf_link)"
            fi
            check_paper_found && return
        fi

        # 	>> IF USER_SEARCH CONTAINS "/" >> EITHER VALID URL (but previous test failed) or BADLY FORMATED URL or DOI
        if [[ $(grep -o "/" <<< "$user_search" | head -n 1) ]]; then
            download_link="$(fetch_page "${site}/${user_search}" | extract_pdf_link)"

            if [[ -z "${download_link}" ]]; then
                download_link="$(fetch_page "${user_search}" | extract_pdf_link)"
            fi

            if [[ -z "${download_link}" ]]; then
                download_link="$(fetch_page "https://${user_search}" | extract_pdf_link)"
            fi

            if [[ -z "${download_link}" ]]; then
                download_link="$(fetch_page "http://${user_search}" | extract_pdf_link)"
            fi

            if [[ -z "${download_link}" ]]; then
                transform_to_doi=$(echo "${user_search}"        | \
                    sed "s,$site/,, ; s,$url_without_http/,,"   | \
                    sed 's/https\?:\/\///'                      | \
                    sed "s/doi.org\///" )

                download_link="$(fetch_page "${site}/${transform_to_doi}" | extract_pdf_link)"
            fi

            check_paper_found && return
        fi

        # 	>> SIMPLE USER SEARCH ; NOT A URL (might have a DOI in there) >> SEARCH ON CROSSREF
        if [[ ! $concatenate =~ https?:// || $concatenate =~ doi ]]; then
            search_crossref
            check_paper_found && return
        fi

        #   >> LAST RESORT: LIBGEN with DOI
        # As Crossref was used just before, DOI should be available
        if [[ -n "$doi" ]]; then
            search_libgen
            check_paper_found && return
        fi

        #	>> IF NOTHING WORKED :'(
        if [[ "$quiet" != true ]]; then
            echo -e "${_R}Paper not found.${_RST}"
        fi
        if [[ "$listing" = true ]]; then
            if [[ "$quiet" != true ]]; then
                echo -e "${_ERASE_UP}${_ERASE}${_ERASE_UP}${_ERASE}${_ERASE_UP}"
                echo -e "${_R}${_BOLD}($ref_index/$bib_size)${_RST} ${_BLACK}${_BOLD}${adjusted_line}${_RST}";
            fi
            not_found=$(( not_found + 1 ))
            concatenate_no_space=$(sed "s/\ /%%space%%/g" <<< $concatenate)
            missed+=($concatenate_no_space)
        fi
    fi
}

check_website_url_inside_link() {
    if [[ $download_link =~ ^(https?://)?libgen.li ]]; then
        # Nothing to change in "download_link" if from libgen() function.
        return
    fi

    case "$download_link" in
        "") ;;
        http://*|https://*) ;;
        //*) download_link="https:${download_link}" ;;
        /*)  download_link="${site}${download_link}" ;;
        *)   download_link="${site}/${download_link}" ;;
    esac
}

check_paper_found() {
    download_paper
    if [[ "$paper_found" == true ]]; then
        unset paper_found
        return 0
    fi
    return 1
}

get_ref() {
    bibtex_ref=$(curl -Ls "http://api.crossref.org/works/$doi/transform/application/x-bibtex")
    echo -e "\n${_BLACK}${_BOLD}${bibtex_ref}${_RST}\n"
    xclip -i <<< "$bibtex_ref"
}

download_paper() {
    check_website_url_inside_link
    if [[ $download_link == "" ]]; then
        unset download_link
        return
    fi
    filename=$(sed 's:.*/::;s:[?#].*::' <<< "$download_link")
    if [[ -z "$filename" ]]; then
        if [[ "$listing" == false ]]; then
            exit 3
        fi
        return
    else
        if grep -q "get.php" <<< "$filename" ;then
            # it comes from libgen.li
            filename="${lg_author}${lg_year}.pdf"
        fi
        cd "$destination"
        if [[ $quiet != true ]]; then
            echo "${_BOLD}Downloading ...${_RST}"
            ( curl -L "$download_link" --output "$filename" --progress-bar || \
              curl -L "${site}/$download_link" --output "$filename" )
            echo "${_G}Done!${_RST}"
            if [[ "$listing" == true ]]; then
                # erase three lines above, then display text in green
                echo -e "${_ERASE_UP}${_ERASE}${_ERASE_UP}${_ERASE}${_ERASE_UP}${_ERASE}${_ERASE_UP}${_ERASE}${_ERASE_UP}"
                echo -e "${_G}${_BOLD}($ref_index/$bib_size)${_RST} ${_G}${adjusted_line}${_RST}";
            fi
        else
            ( curl -Ls "$download_link" --output "$filename" || \
              curl -Ls "${site}/$download_link" --output "$filename" )
        fi

        if [[ -n "$bib_ref" ]]; then
            get_ref
        fi
        unset download_link

        if [[ "$automatically_open" == true ]]; then
            setsid "$READER" "${destination}/$filename"
        fi
        paper_found=true
        return
    fi
}

get_bibliography() {
    if [[ ! -f "$bibliography_file" ]]; then
        echo "${_Y}Bibliography file not found. Trying something anyway.${_RST}"
        listing=false
        paper_search
    fi
    automatically_open=false
    ref_index=0
    not_found=0
    bib_size=$(wc -l "$bibliography_file" | awk '{print $1}')
    if [[ $quiet != true ]]; then
        echo ""
        echo -e "${_B}Searching for ${_BOLD}${_R}${bib_size}${_RST}${_B} references from file ${_R}\"${bibliography_file}\"${_RST}${_B}.${_RST}";
    fi;
    while read -r line; do
        concatenate="$line"
        if [[ "$concatenate" == "" ]]; then
            continue
        fi
        ref_index=$(( ref_index + 1 ))
        term_size=${COLUMNS:-$(tput cols)}
        if [ $(( ${#line} + ${#ref_index} + 3 + 1 )) -gt $term_size ]; then
            adjusted_line="${line:0:$(( term_size - 3 - 1 - ${#ref_index} - ${#bib_size} - 3 ))}..."
        else
            adjusted_line="$line"
        fi
        if [[ ! $quiet = true ]]; then
            echo -e "${_BLACK}${_BOLD}($ref_index/$bib_size)${_RST} ${_BLACK}${_BOLD}${adjusted_line}${_RST}"
        fi
        paper_search "$line"
        if [[ -n "$wait_between_requests" && $(expr $(( ref_index )) % $break_after) != 0 ]]; then
            if [[ ! $quiet = true ]]; then
                c=$(sed "s/\..*//" <<< "$wait_between_requests")
                if [[ $c -ge 1 ]]; then
                    echo ""
                    for x in $(seq 0 $((c - 1))); do
                        echo -e "${_ERASE_UP}${_ERASE_UP}"
                        echo -e "${_DIM}${_ITAL}${_Y}\tWaiting $(( $c - $x )) seconds before next request...${_RST}";
                        sleep 1
                    done
                    echo -e "${_ERASE_UP}${_ERASE}${_ERASE_UP}"
                else
                    sleep $wait_between_requests
                fi
            else
                sleep $wait_between_requests
            fi
        fi
        if [[ -n $break_after && $(expr $(( ref_index )) % $break_after ) == 0 ]]; then
            # if last line of bibliography file, don't sleep
            if [[ $ref_index != $bib_size ]]; then
                if [[ ! $quiet = true ]]; then
                    c=$(sed "s/\..*//" <<< "$break_for")
                    if [[ $c -ge 1 ]]; then
                        echo ""
                        for x in $(seq 0 $((c - 1)) ); do
                            echo -e "${_ERASE_UP}${_ERASE_UP}"
                            echo -e "\t${_DIM}${_BLNK}${_Y}[BREAK]${_RST}${_DIM}${_ITAL}${_Y} Waiting $(( $c - $x )) seconds before next batch...${_RST}";
                            sleep 1
                        done
                        echo -e "${_ERASE_UP}${_ERASE}${_ERASE_UP}"
                    else
                        sleep $break_for
                    fi
                else
                    sleep $break_for
                fi
            fi
        fi
    done < "$bibliography_file"
    if [[ $quiet != true ]]; then
        echo -e "${_B}\nFinished reading ${_R}\"$bibliography_file\"${_B}.${_RST}"
        if [[ $not_found != "0" ]]; then
            echo -e "${_Y}$(( ref_index - not_found ))/$ref_index papers found.${_RST}"
            echo -e "${_R}Not found:${_RST}"
            missing=${#missed[@]} # nb missed papers
                for ((i=0;i<missing;i++)); do
                    missed_rebuilt=$(sed "s/%%space%%/\ /g" <<< ${missed[${i}]})
                    echo -e "\t${_R}- ${missed_rebuilt}${_RST}"
                done
            else
                echo -e "${_G}${ref_index}/${ref_index} papers found!${_RST}"
        fi
    fi
    exit 0
}

main() {
    display_logo
    parse_args "$@"
    set_download_folder
    set_pdf_reader
    set_url
    if [[ "$listing" = true ]]; then
        missed=() # keep track of missing papers
            get_bibliography
    fi
    paper_search
    exit 0
}

main "$@"

